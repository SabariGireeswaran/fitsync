<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fitsync.controller.DashboardController">

    <!-- ============================ SIDEBAR ============================ -->
    <left>
        <VBox styleClass="sidebar">

            <VBox spacing="4">
                <padding><Insets top="26" right="22" bottom="18" left="22"/></padding>
                <Label text="FitSync" styleClass="sidebar-brand"/>
                <Label fx:id="sidebarNameLabel" text="—" styleClass="sidebar-user-name"/>
                <Label fx:id="sidebarEmailLabel" text="—" styleClass="sidebar-user-email"/>
            </VBox>

            <Region styleClass="sidebar-divider"/>

            <VBox spacing="0">
                <padding><Insets top="10" bottom="10"/></padding>
                <Button text="Dashboard"    onAction="#showDashboard"      maxWidth="Infinity" styleClass="nav-item,nav-item-active"/>
                <Button text="BMI Calculator" onAction="#showBmi"          maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="Workout Log"   onAction="#showWorkout"       maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="Weight Tracker" onAction="#showWeight"       maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="Goals"         onAction="#showGoals"         maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="Reports"       onAction="#showReport"        maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="AI Advisor"    onAction="#showRecommendation" maxWidth="Infinity" styleClass="nav-item"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8">
                <Region styleClass="sidebar-divider"/>
                <VBox>
                    <padding><Insets top="8" right="22" bottom="10" left="22"/></padding>
                    <Button text="Log Out" onAction="#handleLogout" maxWidth="Infinity"
                            styleClass="nav-item,nav-item-danger"/>
                </VBox>
                <Label fx:id="versionLabel" text="FitSync v5.0.0" styleClass="sidebar-version">
                    <padding><Insets top="0" right="22" bottom="16" left="22"/></padding>
                </Label>
            </VBox>

        </VBox>
    </left>

    <!-- ========================== MAIN CONTENT ========================= -->
    <center>
        <VBox styleClass="screen" spacing="10">

            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label fx:id="welcomeLabel" text="Welcome back!" styleClass="page-title"/>
                <ProgressIndicator fx:id="loadingIndicator" prefWidth="22" prefHeight="22"
                                   visible="false" managed="false"/>
            </HBox>
            <Label text="Here is your wellness summary" styleClass="page-subtitle"/>

            <Label text="" minHeight="8"/>

            <HBox spacing="20">

                <VBox styleClass="stat-card">
                    <Label text="&#9829;" styleClass="stat-icon" style="-fx-text-fill:#E0607A;"/>
                    <Label text="YOUR BMI" styleClass="stat-caption"/>
                    <Label fx:id="bmiLabel" text="--" styleClass="stat-value"/>
                    <Label fx:id="bmiCategoryLabel" text="Not calculated yet" styleClass="stat-foot"/>
                </VBox>

                <VBox styleClass="stat-card">
                    <Label text="&#9889;" styleClass="stat-icon" style="-fx-text-fill:#2F9E5F;"/>
                    <Label text="WORKOUTS LOGGED" styleClass="stat-caption"/>
                    <Label fx:id="workoutCountLabel" text="0" styleClass="stat-value,stat-value-green"/>
                    <Label text="Total sessions" styleClass="stat-foot"/>
                </VBox>

                <VBox styleClass="stat-card">
                    <Label text="&#9878;" styleClass="stat-icon" style="-fx-text-fill:#DD6B20;"/>
                    <Label text="CURRENT WEIGHT" styleClass="stat-caption"/>
                    <Label fx:id="weightLabel" text="-- kg" styleClass="stat-value,stat-value-orange"/>
                    <Label text="Last recorded" styleClass="stat-foot"/>
                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
