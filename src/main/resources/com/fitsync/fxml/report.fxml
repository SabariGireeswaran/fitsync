<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fitsync.controller.ReportController"
            style="-fx-background-color: #F8F9FA;">

    <VBox spacing="20" style="-fx-background-color: #F8F9FA;">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="Progress Report"
               style="-fx-font-size: 28px; -fx-font-weight: bold;
                      -fx-text-fill: #2D3748;"/>

        <Label text="A summary of your wellness activity over time"
               style="-fx-font-size: 14px; -fx-text-fill: #718096;"/>

        <!-- Workout stats -->
        <HBox spacing="20">
            <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                         -fx-padding: 24; -fx-min-width: 200px;">
                <Label text="TOTAL WORKOUTS"
                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                <Label fx:id="totalWorkoutsLabel" text="0"
                       style="-fx-font-size: 32px; -fx-font-weight: bold;
                              -fx-text-fill: #27AE60;"/>
                <Label text="Total sessions logged"
                       style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
            </VBox>
            <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                         -fx-padding: 24; -fx-min-width: 200px;">
                <Label text="AVERAGE CALORIES BURNED"
                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                <Label fx:id="avgCaloriesLabel" text="0 kcal"
                       style="-fx-font-size: 32px; -fx-font-weight: bold;
                              -fx-text-fill: #DD6B20;"/>
                <Label text="Per workout session"
                       style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
            </VBox>
        </HBox>

        <!-- Weight change over time -->
        <VBox spacing="6"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 24;">
            <Label text="WEIGHT CHANGE OVER TIME"
                   style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
            <Label fx:id="weightChangeLabel" text="Not enough data"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                          -fx-text-fill: #4A90D9;"/>
            <Label fx:id="weightRangeLabel" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #718096;"
                   wrapText="true"/>
        </VBox>

        <!-- BMI history -->
        <VBox spacing="8"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 24;">
            <Label text="BMI HISTORY"
                   style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
            <Label fx:id="emptyBmiLabel" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
            <ListView fx:id="bmiHistoryList" maxHeight="220"/>
        </VBox>

        <Button text="Back to Dashboard"
                onAction="#handleBack"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #4A90D9;
                       -fx-cursor: hand;"/>

    </VBox>

</ScrollPane>
