<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fitsync.controller.ReportController">

    <VBox styleClass="screen" spacing="16">

        <HBox alignment="CENTER_LEFT" spacing="14">
            <Label text="Progress Report" styleClass="page-title"/>
            <ProgressIndicator fx:id="loadingIndicator" prefWidth="22" prefHeight="22"
                               visible="false" managed="false"/>
        </HBox>
        <Label text="A summary of your wellness activity over time" styleClass="page-subtitle"/>

        <HBox spacing="20">
            <VBox styleClass="stat-card">
                <Label text="TOTAL WORKOUTS" styleClass="stat-caption"/>
                <Label fx:id="totalWorkoutsLabel" text="0" styleClass="stat-value,stat-value-green"/>
                <Label text="Total sessions logged" styleClass="stat-foot"/>
            </VBox>
            <VBox styleClass="stat-card">
                <Label text="AVERAGE CALORIES BURNED" styleClass="stat-caption"/>
                <Label fx:id="avgCaloriesLabel" text="0 kcal" styleClass="stat-value,stat-value-orange"/>
                <Label text="Per workout session" styleClass="stat-foot"/>
            </VBox>
        </HBox>

        <VBox styleClass="card">
            <Label text="WEIGHT CHANGE OVER TIME" styleClass="stat-caption"/>
            <Label fx:id="weightChangeLabel" text="Not enough data"
                   style="-fx-font-size:26px; -fx-font-weight:bold; -fx-text-fill:#4A90D9;"/>
            <Label fx:id="weightRangeLabel" text="" styleClass="label-hint" wrapText="true"/>
        </VBox>

        <VBox styleClass="card">
            <Label text="BMI HISTORY" styleClass="stat-caption"/>
            <Label fx:id="emptyBmiLabel" text="" styleClass="label-hint"/>
            <ListView fx:id="bmiHistoryList" prefHeight="220"/>
        </VBox>

        <Button text="Back to Dashboard" onAction="#handleBack" styleClass="btn-ghost"/>

    </VBox>

</ScrollPane>
