<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="screen" spacing="16"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsync.controller.GoalController">

    <Label text="Goal Management" styleClass="page-title"/>
    <Label text="Set wellness goals and track your progress" styleClass="page-subtitle"/>

    <VBox styleClass="card" maxWidth="640">

        <VBox spacing="4">
            <Label text="GOAL DESCRIPTION" styleClass="field-label"/>
            <TextField fx:id="descriptionField" promptText="e.g. Reach target weight, Run 100 km" maxWidth="Infinity"/>
        </VBox>

        <HBox spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="TARGET VALUE" styleClass="field-label"/>
                <TextField fx:id="targetField" promptText="e.g. 70" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="CURRENT VALUE" styleClass="field-label"/>
                <TextField fx:id="currentField" promptText="e.g. 78" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" text="" styleClass="label-error" wrapText="true"/>
        <Label fx:id="successLabel" text="" styleClass="label-success" wrapText="true"/>

        <Button fx:id="addButton" text="Add Goal" onAction="#handleAddGoal" styleClass="btn-primary"/>
    </VBox>

    <Label text="Your Goals" styleClass="section-title"/>

    <TableView fx:id="goalTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="descriptionCol" text="Description" prefWidth="220"/>
            <TableColumn fx:id="targetCol" text="Target" prefWidth="90"/>
            <TableColumn fx:id="currentCol" text="Current" prefWidth="90"/>
            <TableColumn fx:id="progressCol" text="Progress (%)" prefWidth="120"/>
            <TableColumn fx:id="dateCol" text="Created At" prefWidth="170"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Button text="Back to Dashboard" onAction="#handleBack" styleClass="btn-ghost"/>

</VBox>
