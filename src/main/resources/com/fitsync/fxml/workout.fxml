<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsync.controller.WorkoutController"
      style="-fx-background-color: #F8F9FA;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Workout Logger"
           style="-fx-font-size: 28px; -fx-font-weight: bold;
                  -fx-text-fill: #2D3748;"/>

    <Label text="Log your workout sessions"
           style="-fx-font-size: 14px; -fx-text-fill: #718096;"/>

    <VBox spacing="12"
          style="-fx-background-color: white; -fx-background-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                 -fx-padding: 24;">

        <Label text="Exercise Type" style="-fx-font-weight: bold;"/>
        <TextField fx:id="exerciseField"
                   promptText="e.g. Running, Cycling, Push-ups"
                   maxWidth="500"/>

        <HBox spacing="20">
            <VBox spacing="6">
                <Label text="Duration (minutes)" style="-fx-font-weight: bold;"/>
                <TextField fx:id="durationField"
                           promptText="e.g. 30"
                           maxWidth="230"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Calories Burned" style="-fx-font-weight: bold;"/>
                <TextField fx:id="caloriesField"
                           promptText="e.g. 250"
                           maxWidth="230"/>
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill: #E53E3E; -fx-font-size: 13px;"/>
        <Label fx:id="successLabel" text=""
               style="-fx-text-fill: #27AE60; -fx-font-size: 13px;"/>

        <Button text="Log Workout"
                onAction="#handleLogWorkout"
                style="-fx-background-color: #4A90D9;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 10 24 10 24;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
    </VBox>

    <Label text="Workout History"
           style="-fx-font-size: 18px; -fx-font-weight: bold;
                  -fx-text-fill: #2D3748;"/>

    <TableView fx:id="workoutTable" maxHeight="300">
        <columns>
            <TableColumn fx:id="exerciseCol" text="Exercise" minWidth="150"/>
            <TableColumn fx:id="durationCol" text="Duration (min)" minWidth="130"/>
            <TableColumn fx:id="caloriesCol" text="Calories" minWidth="100"/>
            <TableColumn fx:id="dateCol" text="Date" minWidth="160"/>
        </columns>
    </TableView>

    <Button text="Back to Dashboard"
            onAction="#handleBack"
            style="-fx-background-color: transparent;
                   -fx-text-fill: #4A90D9;
                   -fx-cursor: hand;"/>

</VBox>