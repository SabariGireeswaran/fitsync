<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="screen" spacing="16"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsync.controller.WorkoutController">

    <Label text="Workout Log" styleClass="page-title"/>
    <Label text="Record your training sessions" styleClass="page-subtitle"/>

    <VBox styleClass="card" maxWidth="640">

        <VBox spacing="4">
            <Label text="EXERCISE TYPE" styleClass="field-label"/>
            <TextField fx:id="exerciseField" promptText="e.g. Running, Cycling, Push-ups" maxWidth="Infinity"/>
        </VBox>

        <HBox spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="DURATION (MINUTES)" styleClass="field-label"/>
                <TextField fx:id="durationField" promptText="e.g. 30" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="CALORIES BURNED" styleClass="field-label"/>
                <TextField fx:id="caloriesField" promptText="e.g. 250" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" text="" styleClass="label-error" wrapText="true"/>
        <Label fx:id="successLabel" text="" styleClass="label-success" wrapText="true"/>

        <Button fx:id="logButton" text="Log Workout" onAction="#handleLogWorkout" styleClass="btn-primary"/>
    </VBox>

    <Label text="Workout History" styleClass="section-title"/>

    <TableView fx:id="workoutTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="exerciseCol" text="Exercise" prefWidth="200"/>
            <TableColumn fx:id="durationCol" text="Duration (min)" prefWidth="140"/>
            <TableColumn fx:id="caloriesCol" text="Calories" prefWidth="120"/>
            <TableColumn fx:id="dateCol" text="Logged At" prefWidth="180"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Button text="Back to Dashboard" onAction="#handleBack" styleClass="btn-ghost"/>

</VBox>
