<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="screen" spacing="16"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsync.controller.BmiController">

    <Label text="BMI Calculator" styleClass="page-title"/>
    <Label text="Calculate and record your Body Mass Index" styleClass="page-subtitle"/>

    <VBox styleClass="card" maxWidth="520">
        <HBox spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="WEIGHT (KG)" styleClass="field-label"/>
                <TextField fx:id="weightField" promptText="e.g. 70" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="HEIGHT (CM)" styleClass="field-label"/>
                <TextField fx:id="heightField" promptText="e.g. 175" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" text="" styleClass="label-error" wrapText="true"/>

        <Button fx:id="calculateButton" text="Calculate BMI" onAction="#handleCalculate"
                styleClass="btn-primary"/>
    </VBox>

    <VBox fx:id="resultBox" styleClass="card" maxWidth="520" spacing="6"
          visible="false" managed="false">
        <Label text="YOUR BMI RESULT" styleClass="stat-caption"/>
        <Label fx:id="bmiValueLabel" text="--" style="-fx-font-size:44px; -fx-font-weight:bold; -fx-text-fill:#4A90D9;"/>
        <Label fx:id="bmiCategoryLabel" text="" styleClass="section-title"/>
        <Label fx:id="bmiAdviceLabel" text="" styleClass="label-hint" wrapText="true"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Button text="Back to Dashboard" onAction="#handleBack" styleClass="btn-ghost"/>

</VBox>
