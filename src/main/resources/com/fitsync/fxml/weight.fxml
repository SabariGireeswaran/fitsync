<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsync.controller.WeightController"
      style="-fx-background-color: #F8F9FA;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Weight Tracker"
           style="-fx-font-size: 28px; -fx-font-weight: bold;
                  -fx-text-fill: #2D3748;"/>

    <Label text="Record and track your body weight over time"
           style="-fx-font-size: 14px; -fx-text-fill: #718096;"/>

    <VBox spacing="12"
          style="-fx-background-color: white; -fx-background-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                 -fx-padding: 24;">

        <Label text="Weight (kg)" style="-fx-font-weight: bold;"/>
        <TextField fx:id="weightField"
                   promptText="e.g. 72.5"
                   maxWidth="300"/>

        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill: #E53E3E; -fx-font-size: 13px;"/>
        <Label fx:id="successLabel" text=""
               style="-fx-text-fill: #27AE60; -fx-font-size: 13px;"/>

        <Button text="Log Weight"
                onAction="#handleLogWeight"
                style="-fx-background-color: #4A90D9;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 10 24 10 24;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
    </VBox>

    <Label text="Weight History"
           style="-fx-font-size: 18px; -fx-font-weight: bold;
                  -fx-text-fill: #2D3748;"/>

    <TableView fx:id="weightTable" maxHeight="300">
        <columns>
            <TableColumn fx:id="weightCol" text="Weight (kg)" minWidth="150"/>
            <TableColumn fx:id="dateCol" text="Recorded At" minWidth="200"/>
        </columns>
    </TableView>

    <Button text="Back to Dashboard"
            onAction="#handleBack"
            style="-fx-background-color: transparent;
                   -fx-text-fill: #4A90D9;
                   -fx-cursor: hand;"/>

</VBox>
