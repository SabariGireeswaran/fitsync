<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="screen" spacing="16"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsync.controller.WeightController">

    <Label text="Weight Tracker" styleClass="page-title"/>
    <Label text="Record your body weight and watch the trend" styleClass="page-subtitle"/>

    <VBox styleClass="card" maxWidth="420">
        <VBox spacing="4">
            <Label text="WEIGHT (KG)" styleClass="field-label"/>
            <TextField fx:id="weightField" promptText="e.g. 72.5" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" text="" styleClass="label-error" wrapText="true"/>
        <Label fx:id="successLabel" text="" styleClass="label-success" wrapText="true"/>

        <Button fx:id="logButton" text="Log Weight" onAction="#handleLogWeight" styleClass="btn-primary"/>
    </VBox>

    <Label text="Weight History" styleClass="section-title"/>

    <TableView fx:id="weightTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="weightCol" text="Weight (kg)" prefWidth="180"/>
            <TableColumn fx:id="dateCol" text="Recorded At" prefWidth="240"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Button text="Back to Dashboard" onAction="#handleBack" styleClass="btn-ghost"/>

</VBox>
